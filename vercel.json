{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(img/.*|favicon.svg|style.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/servicios/asesoria-preventiva",
      "destination": "/asesoria-permanente",
      "permanent": true
    },
    {
      "source": "/servicios/asesoria-preventiva.html",
      "destination": "/asesoria-permanente",
      "permanent": true
    },
    {
      "source": "/servicios/defensa-y-patrocinio",
      "destination": "/defensa-puntual",
      "permanent": true
    },
    {
      "source": "/servicios/defensa-y-patrocinio.html",
      "destination": "/defensa-puntual",
      "permanent": true
    }
  ]
}
